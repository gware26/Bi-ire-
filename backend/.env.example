# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# Used in order when the main model is busy (503), out of quota (429) or times out.
# Free tier = ~20 requests/day PER MODEL, so a longer list = more requests per day.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.1-flash-lite-preview,gemini-3.8-flash,gemini-3.5-flash,gemini-3.1-flash-lite
GEMINI_TIMEOUT=45

# 1 = always use the scripted demo lecture (no API calls). Also on automatically when no key is set.
DEMO_MODE=0
